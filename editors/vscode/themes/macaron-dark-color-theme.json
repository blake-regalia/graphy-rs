{
	"$schema": "vscode://schemas/color-theme",
	"name": "Macaron Dark (Graphy)",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"editor.foreground": "#bebbb0",
		"foreground": "#bebbb0",
		"editor.background": "#252525",
		"editorGutter.background": "#323232",
		"editorCursor.foreground": "#c9c9c3",
		"focusBorder": "#ff00ff",
		"editorIndentGuide.background": "#323334",
		"editorIndentGuide.activeBackground": "#48494a",
		"editor.lineHighlightBackground": "#3e3e3e",
		"editor.selectionHighlightBackground": "#a5eb5144",
		"editor.findMatchBackground": "#e9ee5f99",
		"editor.selectionBackground": "#575757"
