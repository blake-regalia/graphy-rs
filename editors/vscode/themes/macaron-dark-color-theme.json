	"semanticTokenColors": {
		"namespace": {
			"foreground": "#d85f77"
		},
		"type": {
			"foreground": "#6472c4"
		},
		"class": {
			"foreground": "#bea4d6"
		},
		"enumMember": {
			"foreground": "#4be293"
		},
		"variable": {
			"foreground": "#f3aa6d"
