		"string": {
			"foreground": "#66c794"
		},
		"number": {
			"foreground": "#66c794"
		},
		"keyword": {
			"foreground": "#708acd"
		},
		"operator": {
			"foreground": "#9ac0e0"
		},
		"comment": {
			"foreground": "#758b99",
			"fontStyle": "italic"
		},
		"macro": {
			"foreground": "#b242b3"
		},
		"decorator": {
			"foreground": "#7cd5c0"
		}
	},
	"tokenColors": [
