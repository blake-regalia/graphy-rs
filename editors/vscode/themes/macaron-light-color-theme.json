{
	"$schema": "vscode://schemas/color-theme",
	"name": "Macaron Light (Graphy)",
	"type": "light",
	"semanticHighlighting": true,
	"colors": {
		"editor.foreground": "#333366",
		"foreground": "#333366",
		"editor.background": "#eff1f5",
		"editorGutter.background": "#c0c5ce",
		"editorCursor.foreground": "#666666",
		"focusBorder": "#333333",
		"editor.lineHighlightBackground": "#a7adba",
		"editor.selectionHighlightBackground": "#a5eb5144",
		"editor.findMatchBackground": "#ffe792",
		"editor.selectionBackground": "#dfe1e8"
	},
	"semanticTokenColors": {
		"namespace": {
			"foreground": "#c9314f"
		},
		"type": {
			"foreground": "#3a4798"
		},
		"class": {
			"foreground": "#8f61b8"
		},
		"enumMember": {
			"foreground": "#20c56f"
		},
		"variable": {
			"foreground": "#ed981d"
		},
		"property": {
			"foreground": "#ee5d84"
		},
		"string": {
			"foreground": "#3bab70"
		},
		"number": {
			"foreground": "#3bab70"
		},
		"keyword": {
			"foreground": "#3957a2"
		},
		"operator": {
			"foreground": "#607dc7"
		},
		"comment": {
			"foreground": "#711414b2",
			"fontStyle": "italic"
		},
		"macro": {
			"foreground": "#89338a"
		},
		"decorator": {
			"foreground": "#39c6a5"
		}
	},
	"tokenColors": [
		{
			"scope": "comment",
			"settings": {
				"foreground": "#711414b2",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#6600771b"
			}
		},
		{
			"scope": "meta.path.inverse",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "keyword.operator.path.quantifier.one-or-more",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "storage.modifier",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "meta.annotation",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "string.regexp constant.other.character-class.predefined, string.regexp constant.other.character-class punctuation, string.regexp constant.other.character-class.set",
