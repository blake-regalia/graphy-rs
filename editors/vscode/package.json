{
  "name": "graphy-lsp",
  "displayName": "Graphy LSP",
  "description": "Language support for RDF text formats (Turtle, TriG, N-Triples, N-Quads, JSON-LD) and SPARQL via graphy-lsp",
  "version": "0.1.0",
  "publisher": "graphy",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "turtle",
        "aliases": [
          "Turtle",
          "TriG",
          "N-Triples",
          "N-Quads"
        ],
        "extensions": [
          ".ttl",
          ".nt",
          ".nq",
          ".trig"
        ],
        "configuration": "./language-configuration/turtle.json"
      },
      {
        "id": "sparql",
        "aliases": [
          "SPARQL"
        ],
        "extensions": [
          ".rq",
          ".ru",
          ".sparql"
        ],
        "configuration": "./language-configuration/sparql.json"
      },
      {
        "id": "jsonld",
        "aliases": [
          "JSON-LD"
        ],
        "extensions": [
          ".jsonld"
        ],
        "configuration": "./language-configuration/jsonld.json"
      }
    ],
    "grammars": [
      {
        "language": "turtle",
        "scopeName": "source.ttl",
        "path": "./syntaxes/turtle.tmLanguage.json"
      },
      {
        "language": "sparql",
        "scopeName": "source.rq",
        "path": "./syntaxes/sparql.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "turtle",
        "scopes": {
          "namespace": [
            "variable.other.readwrite.prefixed-name.namespace.graphy"
          ],
          "type": [
            "storage.type.graphy"
          ],
          "class": [
            "string.unquoted.iri.graphy"
          ],
          "enumMember": [
            "support.constant.graphy"
          ],
          "variable": [
            "variable.other.readwrite.var.graphy"
          ],
          "property": [
            "variable.other.member.prefixed-name.local.graphy"
          ],
          "string": [
            "string.quoted.double.literal.graphy"
          ],
          "number": [
            "constant.numeric.graphy"
          ],
          "keyword": [
            "keyword.control.graphy"
          ],
          "operator": [
            "keyword.operator.graphy"
          ],
          "comment": [
            "comment.graphy"
          ],
          "macro": [
            "meta.directive.graphy"
          ],
          "decorator": [
            "string.unquoted.language-tag.graphy"
          ]
        }
      },
      {
        "language": "sparql",
        "scopes": {
          "namespace": [
            "variable.other.readwrite.prefixed-name.namespace.graphy"
          ],
          "type": [
            "storage.type.graphy"
          ],
          "class": [
            "string.unquoted.iri.graphy"
          ],
          "enumMember": [
            "support.constant.graphy"
          ],
          "variable": [
            "variable.other.readwrite.var.graphy"
          ],
          "property": [
            "variable.other.member.prefixed-name.local.graphy"
          ],
          "string": [
            "string.quoted.double.literal.graphy"
          ],
          "number": [
            "constant.numeric.graphy"
          ],
          "keyword": [
            "keyword.control.graphy"
          ],
          "operator": [
            "keyword.operator.graphy"
          ],
          "comment": [
            "comment.graphy"
          ],
          "macro": [
            "meta.directive.graphy"
          ],
          "decorator": [
            "string.unquoted.language-tag.graphy"
          ]
        }
      },
      {
        "language": "jsonld",
        "scopes": {
          "namespace": [
            "variable.other.readwrite.prefixed-name.namespace.graphy"
          ],
          "type": [
            "storage.type.graphy"
          ],
          "class": [
            "string.unquoted.iri.graphy"
          ],
          "enumMember": [
            "support.constant.graphy"
          ],
          "variable": [
            "variable.other.readwrite.var.graphy"
          ],
          "property": [
            "variable.other.member.prefixed-name.local.graphy"
          ],
          "string": [
            "string.quoted.double.literal.graphy"
          ],
          "number": [
            "constant.numeric.graphy"
          ],
          "keyword": [
            "keyword.control.graphy"
          ],
          "operator": [
            "keyword.operator.graphy"
          ],
          "comment": [
            "comment.graphy"
          ],
          "macro": [
            "meta.directive.graphy"
          ],
          "decorator": [
            "string.unquoted.language-tag.graphy"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[turtle]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[sparql]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[jsonld]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "variable.other.readwrite.prefixed-name.namespace.graphy",
            "settings": {
              "foreground": "#d85f77"
            }
          },
          {
            "scope": "storage.type.graphy",
            "settings": {
              "foreground": "#6472c4"
            }
          },
          {
            "scope": "string.unquoted.iri.graphy",
            "settings": {
              "foreground": "#bea4d6"
            }
          },
          {
            "scope": "support.constant.graphy",
            "settings": {
              "foreground": "#4be293"
            }
          },
          {
            "scope": "variable.other.readwrite.var.graphy",
            "settings": {
              "foreground": "#f3aa6d"
            }
          },
          {
            "scope": "variable.other.member.prefixed-name.local.graphy",
            "settings": {
              "foreground": "#f3b4c3"
            }
          },
          {
            "scope": "string.quoted.double.literal.graphy",
            "settings": {
              "foreground": "#66c794"
            }
          },
          {
            "scope": "constant.numeric.graphy",
            "settings": {
              "foreground": "#66c794"
            }
          },
          {
            "scope": "keyword.control.graphy",
            "settings": {
              "foreground": "#708acd"
            }
