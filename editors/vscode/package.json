          {
            "scope": "keyword.operator.graphy",
            "settings": {
              "foreground": "#9ac0e0"
            }
          },
          {
            "scope": "comment.graphy",
            "settings": {
              "foreground": "#758b99",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "meta.directive.graphy",
            "settings": {
              "foreground": "#b242b3"
            }
          },
          {
            "scope": "string.unquoted.language-tag.graphy",
            "settings": {
              "foreground": "#7cd5c0"
            }
          },
          {
            "scope": "string.unquoted.iri.ttl",
            "settings": {
              "foreground": "#bea4d6"
            }
          },
          {
            "scope": "constant.character.escape.iri.ttl",
            "settings": {
              "foreground": "#a76bae"
            }
          },
          {
            "scope": "punctuation.definition.iri.begin.ttl, punctuation.definition.iri.end.ttl",
            "settings": {
