          {
            "scope": "string.quoted.double.literal.ttl, string.quoted.single.literal.ttl",
            "settings": {
              "foreground": "#66c794"
            }
          },
          {
            "scope": "punctuation.definition.string.begin.ttl, punctuation.definition.string.end.ttl",
            "settings": {
