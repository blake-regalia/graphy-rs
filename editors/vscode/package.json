    },
    "themes": [
      {
        "label": "Macaron Dark (Graphy)",
        "uiTheme": "vs-dark",
        "path": "./themes/macaron-dark-color-theme.json"
      },
      {
        "label": "Macaron Light (Graphy)",
        "uiTheme": "vs",
        "path": "./themes/macaron-light-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Graphy LSP",
      "properties": {
        "graphy-lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the graphy-lsp server binary. If empty, falls back to the GRAPHY_LSP_BIN environment variable, a bundled binary, or `graphy-lsp` on PATH."
        }
      }
    }
  },
  "scripts": {
    "package": "cp ../../target/release/graphy-lsp server/graphy-lsp && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
