          },
          {
            "scope": "punctuation.separator.language-tag.symbol.ttl",
            "settings": {
              "foreground": "#525738"
            }
          },
          {
            "scope": "constant.numeric.ttl",
            "settings": {
              "foreground": "#66c794"
            }
          },
          {
            "scope": "constant.language.boolean.ttl",
            "settings": {
              "foreground": "#70b6f0"
            }
          },
          {
            "scope": "storage.type.prefix.ttl, storage.type.prefix.at.ttl, storage.type.prefix.sparql.ttl",
            "settings": {
              "foreground": "#6472c4"
            }
          },
          {
            "scope": "punctuation.definition.storage.prefix.at.ttl",
