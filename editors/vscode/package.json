          },
          {
            "scope": "punctuation.separator.datatype.symbol.ttl",
            "settings": {
              "foreground": "#633d31"
            }
          },
          {
            "scope": "keyword.control.graph.trig",
            "settings": {
              "foreground": "#708acd"
            }
          },
          {
            "scope": "comment.line.ttl, punctuation.definition.comment.ttl",
            "settings": {
              "foreground": "#758b99",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "string.unquoted.iri.rq",
            "settings": {
              "foreground": "#bea4d6"
            }
          },
