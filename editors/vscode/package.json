            }
          },
          {
            "scope": "constant.character.escape.prefixed-name.local.rq",
            "settings": {
              "foreground": "#f297ae"
            }
          },
          {
            "scope": "support.constant.predicate.a.rq",
            "settings": {
              "foreground": "#933e49"
            }
          },
          {
            "scope": "string.quoted.double.literal.rq, string.quoted.single.literal.rq",
            "settings": {
              "foreground": "#66c794"
            }
          },
          {
            "scope": "punctuation.definition.string.begin.rq, punctuation.definition.string.end.rq",
            "settings": {
              "foreground": "#539b4b"
            }
          },
          {
            "scope": "constant.character.escape.literal.rq",
            "settings": {
              "foreground": "#5b7141"
            }
          },
          {
            "scope": "string.unquoted.language-tag.rq",
            "settings": {
              "foreground": "#7cd5c0"
            }
          },
          {
            "scope": "punctuation.separator.language-tag.symbol.rq",
            "settings": {
              "foreground": "#525738"
            }
          },
          {
            "scope": "constant.numeric.rq",
            "settings": {
              "foreground": "#66c794"
            }
          },
          {
            "scope": "constant.language.boolean.rq",
            "settings": {
              "foreground": "#70b6f0"
            }
          },
          {
            "scope": "variable.other.readwrite.blank-node.underscore.rq",
            "settings": {
              "foreground": "#a262a3"
            }
          },
          {
            "scope": "variable.other.member.blank-node.label.rq",
            "settings": {
              "foreground": "#cec1e6"
            }
          },
          {
            "scope": "punctuation.separator.object.rq",
            "settings": {
              "foreground": "#cb7334"
            }
