            }
          },
          {
            "scope": "keyword.operator.word.qualifier.rq",
            "settings": {
              "foreground": "#669deb"
            }
          },
          {
            "scope": "keyword.operator.word.modifier.rq, keyword.operator.word.optional.rq, keyword.operator.word.union.rq, keyword.operator.word.minus.rq, keyword.operator.word.group.rq, keyword.operator.star.rq, keyword.operator.conditional.and.rq, keyword.operator.conditional.or.rq, keyword.operator.relational.equality.rq, keyword.operator.relational.non-equality.rq, keyword.operator.relational.less-than.rq, keyword.operator.relational.greater-than.rq, keyword.operator.relational.less-than-or-equal-to.rq, keyword.operator.relational.greater-than-or-equal-to.rq, keyword.operator.logical.not.rq, keyword.operator.arithmetic.addition.rq, keyword.operator.arithmetic.subtraction.rq",
            "settings": {
