          {
            "scope": "keyword.operator.path.inverse.rq, keyword.operator.path.alternative.rq, keyword.operator.path.separator.rq, keyword.operator.path.quantifier.zero-or-one.rq",
            "settings": {
              "foreground": "#80d0f5"
            }
          },
          {
            "scope": "support.function.built-in.rq, support.function.built-in.aggregate.rq, support.function.built-in.sort.rq",
            "settings": {
              "foreground": "#80d0f5"
            }
          },
          {
            "scope": "support.constant.undef.rq, support.constant.graph.rq",
            "settings": {
              "foreground": "#4be293"
            }
          },
          {
            "scope": "punctuation.section.group.begin.rq, punctuation.section.group.end.rq",
            "settings": {
              "foreground": "#4b60dd"
            }
          },
          {
            "scope": "punctuation.definition.expression.begin.rq, punctuation.definition.expression.end.rq",
            "settings": {
              "foreground": "#5880e4"
            }
