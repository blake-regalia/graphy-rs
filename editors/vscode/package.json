            "scope": "storage.modifier.distinct.rq, storage.modifier.reduced.rq",
            "settings": {
              "foreground": "#7fa8d7"
            }
          },
          {
            "scope": "variable.other.readwrite.var.question-mark.rq, variable.other.readwrite.var.dollar-sign.rq, punctuation.definition.variable.var.question-mark.rq, punctuation.definition.variable.var.dollar-sign.rq",
